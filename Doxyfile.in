# Doxyfile for MeshFix3
# Generated for MeshFix3 mesh repair tool

DOCTYPEGRAPH = YES
HTML_OUTPUT = html
XML_OUTPUT = xml

ABBREVIATE_BRIEF = "The $name class" "The $name widget" "The $name file" \
                   is provides contains represents a an and the
ALLEXPANDED_NO = YES
ALWAYS_DETAILED_SEC = NO
BRIEF_MEMBER_PARAMS = YES
BUILTIN_STL_SUPPORT = YES
CASE_SENSE_NAMES = NO
CITE_BIB_FILES =
CLASS_DIAGRAMS = YES
COLLABORATION_GRAPH = YES
COMPACT_LATEX = NO
CREATE_SUBDIRS = NO
DISTRIBUTE_GROUP_DOC = NO
EXTRACT_ALL = YES
EXTRACT_LOCAL_METHODS = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
FILE_PATTERNS = *.h *.cpp *.c
FULL_PATH_NAMES = NO
GENERATE_LATEX = NO
GENERATE_TODOLIST = YES
GENERATE_TREEVIEW = ALL
HAVE_DOT = YES
INLINE_INHERITED_MEMB = YES
MAX_DOT_GRAPH_WIDTH = 1024
MAX_INITIALIZER_LINES = 30
QUIET = YES
SHOW_INCLUDE_FILES = YES
SORT_BRIEF_DOCS = NO
SORT_BY_SCOPE_NAME = NO
STRIP_CODE_COMMENTS = NO
STRICT麤 = NO
TAB_SIZE = 4
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_NO_PARAMDOC = NO